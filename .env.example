# Copy to .env (never commit .env). Every variable is optional.
# Server profiles: if set, users can pick the model in the UI without entering a key.

# --- Azure OpenAI -------------------------------------------------------------
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENTS=gpt-4o-mini,gpt-4.1-mini        # comma-separated deployment names
# AZURE_OPENAI_API_VERSION=2024-10-21

# --- Azure AI Foundry (Llama, Mistral, DeepSeek, Phi, ...) --------------------
# AZURE_AI_FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com/models
# AZURE_AI_FOUNDRY_API_KEY=
# AZURE_AI_FOUNDRY_MODELS=Llama-3.3-70B-Instruct,Mistral-Large-2411

# --- GitHub Models (PAT with models:read) -------------------------------------
# GITHUB_TOKEN=
# GITHUB_MODELS=openai/gpt-4.1-mini,meta/Llama-3.3-70B-Instruct

# --- Ollama on your PC (from Docker use host.docker.internal) -----------------
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# OLLAMA_MODELS=llama3.1:8b,qwen2.5:7b

# --- App hardening (set before exposing the app beyond localhost) -------------
# MBDB_APP_TOKEN=change-me-long-random-string     # required header X-API-Token / Bearer
# MBDB_ALLOW_USER_KEYS=true                       # false = only server profiles
# MBDB_ALLOW_CUSTOM_ENDPOINTS=true                # false = no user-supplied base URLs (SSRF protection)
# MBDB_ENABLED_PROVIDERS=mock-drift,azure-openai,github-models
# MBDB_MAX_CONCURRENT_RUNS=2
# MBDB_MAX_CASES_PER_RUN=1000
# MBDB_MAX_WORKERS=8
# MBDB_DEMO_DELAY_SECONDS=0.15                    # pacing of the mock-drift demo
