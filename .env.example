# Copy to .env (never commit .env). Every variable is optional.

# --- Server profiles: users pick the model without entering a key ------------
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENTS=gpt-4o-mini,gpt-4.1-mini
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_AI_FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com/models
# AZURE_AI_FOUNDRY_API_KEY=
# AZURE_AI_FOUNDRY_MODELS=Llama-3.3-70B-Instruct,Mistral-Large-2411
# GITHUB_TOKEN=                                   # PAT with models:read
# GITHUB_MODELS=openai/gpt-4.1-mini,meta/Llama-3.3-70B-Instruct
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# OLLAMA_MODELS=llama3.1:8b,qwen2.5:7b

# --- External judge (mbdb.judge.v1, e.g. a Jev relay) -------------------------
# MBDB_JUDGE_URL=https://my-judge.example.com/judge
# MBDB_JUDGE_KEY=
# MBDB_JUDGE_LABEL=Jev judge (server)

# --- Hardening (set before exposing the app beyond localhost) -----------------
# MBDB_APP_TOKEN=change-me-long-random-string     # required header X-API-Token / Bearer
# MBDB_ALLOW_USER_KEYS=true                       # false = only server profiles
# MBDB_ALLOW_CUSTOM_ENDPOINTS=true                # false = no user-supplied URLs (SSRF protection)
# MBDB_ENABLED_PROVIDERS=mock-drift,azure-openai,github-models,http-json,http-judge
# MBDB_RATE_LIMIT_PER_MINUTE=10                   # POST/DELETE per client IP; 0 = off
# MBDB_MAX_CONCURRENT_RUNS=2
# MBDB_MAX_CASES_PER_RUN=1000
# MBDB_MAX_WORKERS=8
# MBDB_RETENTION_DAYS=30                          # delete finished runs older than N days; 0 = keep
# MBDB_MAX_RUNS_KEPT=200                          # keep at most N finished runs; 0 = unlimited
# MBDB_LOG_LEVEL=INFO
# MBDB_DEMO_DELAY_SECONDS=0.15
