{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev-techt.github.io/multilingual-bias-drift-benchmark/schema/fillblank.schema.json",
  "title": "Multilingual Bias Drift Benchmark Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tier",
    "language",
    "construct",
    "phenomenon",
    "control_type",
    "difficulty",
    "prompt_template",
    "answer_mode",
    "expected_behavior",
    "scoring",
    "safety_tags",
    "protected_classes",
    "review",
    "notes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^fitb-[a-z]{2}-[a-z0-9-]+$"
    },
    "tier": {
      "type": "string",
      "enum": [
        "public_sample",
        "public_dev",
        "private_holdout",
        "quarantine_candidates",
        "retired_holdout"
      ]
    },
    "language": {
      "type": "string",
      "enum": [
        "ar",
        "bn",
        "de",
        "el",
        "en",
        "es",
        "fa",
        "fr",
        "hi",
        "id",
        "it",
        "ja",
        "ko",
        "mr",
        "nl",
        "pl",
        "pt",
        "ru",
        "sw",
        "ta",
        "te",
        "tr",
        "uk",
        "ur",
        "vi",
        "zh"
      ]
    },
    "translation_group": {
      "type": "string",
      "minLength": 3
    },
    "construct": {
      "type": "string",
      "minLength": 3
    },
    "phenomenon": {
      "type": "string",
      "minLength": 3
    },
    "control_type": {
      "type": "string",
      "enum": [
        "positive_control",
        "negative_control",
        "contrast_control"
      ]
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    },
    "prompt_template": {
      "type": "string",
      "minLength": 10,
      "pattern": "\\{blank\\}"
    },
    "answer_mode": {
      "type": "string",
      "enum": [
        "free_text"
      ]
    },
    "expected_behavior": {
      "type": "string",
      "minLength": 25
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "primary_metric",
        "no_single_correct_answer",
        "rubric"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "rubric_v1"
          ]
        },
        "primary_metric": {
          "type": "string",
          "minLength": 3
        },
        "no_single_correct_answer": {
          "type": "boolean",
          "const": true
        },
        "rubric": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "0",
            "1",
            "2",
            "3"
          ],
          "properties": {
            "0": {
              "type": "string",
              "minLength": 10
            },
            "1": {
              "type": "string",
              "minLength": 10
            },
            "2": {
              "type": "string",
              "minLength": 10
            },
            "3": {
              "type": "string",
              "minLength": 10
            }
          }
        }
      }
    },
    "safety_tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "protected_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance",
        "review_status",
        "reviewer_notes",
        "public_release_ok"
      ],
      "properties": {
        "provenance": {
          "type": "string",
          "minLength": 3
        },
        "review_status": {
          "type": "string",
          "minLength": 3
        },
        "reviewer_notes": {
          "type": "string",
          "minLength": 10
        },
        "public_release_ok": {
          "type": "boolean"
        }
      }
    },
    "notes": {
      "type": "string",
      "minLength": 10
    }
  }
}
